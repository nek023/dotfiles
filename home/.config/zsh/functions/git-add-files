#!/bin/zsh

# Shell quoting alone does not disable Git pathspec globbing.
# git-select-files emits NUL-delimited paths; split on NUL to keep paths with
# spaces or newlines intact.
local -a files
files=("${(@0)$(git-select-files -q "${BUFFER}")}")
files=(${files:#})

if (( ${#files} > 0 )); then
  local -a pathspecs
  pathspecs=(":(top,literal)"${^files})
  BUFFER="git add ${(j: :)${(@q-)pathspecs}}"
  zle accept-line
fi

zle redisplay
