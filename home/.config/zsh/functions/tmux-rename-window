#!/bin/zsh

# Runs as a precmd hook in the pane's shell, and as a script from the tmux hooks
# in tmux.conf when the active pane changes.
local pane_path window_id
if (( ${#funcstack} )); then
  [[ "${PWD}" == "${_tmux_rename_window_pwd-}" ]] && return 0
  typeset -g _tmux_rename_window_pwd="${PWD}"

  # :A resolves symlinks to match pane_current_path.
  pane_path="${PWD:A}"
  window_id="${TMUX_PANE}"
else
  local info="$(tmux display-message -p '#{window_id}:#{pane_current_path}')"
  window_id="${info%%:*}"
  pane_path="${info#*:}"
fi

if [[ -z "${pane_path}" || -z "${window_id}" ]]; then
  return 0
fi

local dir common_dir
common_dir="$(git -C "${pane_path}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
if [[ -n "${common_dir}" ]]; then
  if [[ "${common_dir:t}" == ".git" ]]; then
    dir="${common_dir:h}"
  else
    dir="$(git -C "${pane_path}" rev-parse --show-toplevel 2>/dev/null)"
  fi
fi
dir="${dir:-${pane_path}}"

tmux rename-window -t "${window_id}" "$(basename "$(dirname "${dir}")")/$(basename "${dir}")"
